[32m│[0m  [92mContent: number for an attack roll is called an[0m  [32m│[0m
[32m│[0m  [92mArmor Class (AC). [0m                               [32m│[0m
[32m│[0m  [92m This simple rule governs the resolution of [0m     [32m│[0m
[32m│[0m  [92mmost tasks [0m                                      [32m│[0m
[32m│[0m  [92min D&D play. Chapter 7 provides more detailed [0m   [32m│[0m
[32m│[0m  [92mrules for [0m                                       [32m│[0m
[32m│[0m  [92musing the d20 in the game.[0m                       [32m│[0m
[32m│[0m  [92mAdvantage and Disadvantage[0m                       [32m│[0m
[32m│[0m  [92mSometimes an ability check, attack roll, or [0m     [32m│[0m
[32m│[0m  [92msaving [0m                                          [32m│[0m
[32m│[0m  [92mthrow is modified by special situations called [0m  [32m│[0m
[32m│[0m  [92madvantage and disadvantage. Advantage reflects [0m  [32m│[0m
[32m│[0m  [92mthe [0m                                             [32m│[0m
[32m│[0m  [92mpositive circumstances surrounding a d20 roll, [0m  [32m│[0m
[32m│[0m  [92mwhile [0m                                           [32m│[0m
[32m│[0m  [92mdisadvantage reflects the opposite. When you [0m    [32m│[0m
[32m│[0m  [92mhave [0m                                            [32m│[0m
[32m│[0m  [92meither advantage or disadvantage, you roll a [0m    [32m│[0m
[32m│[0m  [92msecond d20 [0m                                      [32m│[0m
[32m│[0m  [92mwhen you make the roll. Use the higher of the [0m   [32m│[0m
[32m│[0m  [92mtwo rolls[0m                                        [32m│[0m
[32m│[0m  [92mSource: [0m                                         [32m│[0m
